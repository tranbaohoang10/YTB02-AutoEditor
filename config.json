{
  "kokoro_python": "H:\\KokoroCPU\\.venv\\Scripts\\python.exe",
  "ffmpeg": "ffmpeg",
  "ffprobe": "ffprobe",
  "video": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "codec": "libx264",
    "crf": 20,
    "preset": "medium"
  },
  "audio": {
    "sample_rate": 24000,
    "aac_bitrate": "192k",
    "gap_ms": 0,
    "normalize_loudness": true,
    "target_lufs": -18.0,
    "true_peak_db": -1.5,
    "lra": 7.0
  },
  "alignment": {
    "engine": "whisperx",
    "device": "cpu",
    "allow_approximate_fallback": false,
    "model_en": null,
    "model_vi": null,
    "cache_dir": ".cache/alignment",
    "duration_tolerance": 0.25
  },
  "subtitles": {
    "font": "Arial",
    "font_size": 52,
    "margin_bottom": 70,
    "outline": 3,
    "max_chars_per_line": 42,
    "max_lines": 2,
    "max_words_per_window": 6
  }
}
